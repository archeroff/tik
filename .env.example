# Copy this file to `.env`. The SUPABASE_* values expand the environment
# variables of the same names (GitHub Actions variable/secret in CI, or
# exported in your shell locally). Apply supabase/migrations/20260801000000_init.sql first.
SUPABASE_URL=${SUPABASE_URL}
SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
