# Copy this file to `.env`. The VITE_* values expand the environment variables
# of the same names (GitHub Actions secrets/variables in CI, or exported in
# your shell locally). Apply supabase/migrations/20260801000000_init.sql first.
VITE_SUPABASE_URL=${SUPABASE_URL}
VITE_SUPABASE_PUBLISHABLE_KEY=${SUPABASE_PUBLISHABLE_KEY}
