{
  "name": "tic-tac-toe-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Two-player real-time Tic-Tac-Toe PWA (best of three) powered by Firebase Firestore.",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "emulate": "firebase emulators:start --only firestore"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^13.27.0",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10"
  }
}
